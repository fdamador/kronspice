{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "kronspice: all (build image, ngspice golden + twins, race tests)",
      "type": "shell",
      "command": "powershell -NoProfile -ExecutionPolicy Bypass -File internal/golden/docker/run.ps1 -Step all",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": {
        "kind": "test",
        "isDefault": true
      }
    },
    {
      "label": "kronspice: build tools image",
      "type": "shell",
      "command": "powershell -NoProfile -ExecutionPolicy Bypass -File internal/golden/docker/run.ps1 -Step build",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "kronspice: regenerate ngspice golden",
      "type": "shell",
      "command": "powershell -NoProfile -ExecutionPolicy Bypass -File internal/golden/docker/run.ps1 -Step golden",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "kronspice: ngspice twin references",
      "type": "shell",
      "command": "powershell -NoProfile -ExecutionPolicy Bypass -File internal/golden/docker/run.ps1 -Step twin",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "kronspice: go test -race (container)",
      "type": "shell",
      "command": "powershell -NoProfile -ExecutionPolicy Bypass -File internal/golden/docker/run.ps1 -Step test",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$go"
      ]
    }
  ]
}
